# Copy this file to keystore.properties (gitignored) and fill in the values.
# Generate the keystore with:
#   keytool -genkeypair -v \
#     -keystore ~/asala-release.jks \
#     -alias asala-release \
#     -keyalg RSA -keysize 4096 \
#     -validity 10000
#
# RSA 4096 matches Google Play App Signing's default. Validity is 10000 days
# (~27 years), exceeding Google Play's 25-year requirement.
#
# Use the same password for store and key unless you have a reason not to.
# Store the .jks file and the passwords somewhere safe and encrypted:
#   - Passwords in a password manager (1Password, Bitwarden, KeePass).
#   - .jks file as an attachment to the same password-manager entry, OR on
#     an encrypted external drive, OR in encrypted cloud storage.
# Losing the .jks file or its passwords means future updates cannot be
# signed as the same app identity; users would have to uninstall and
# reinstall to receive any further updates.

storeFile=/absolute/path/to/asala-release.jks
storePassword=replace-me
keyAlias=asala-release
keyPassword=replace-me
