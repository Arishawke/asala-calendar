root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_kotlin_packages_to_use_import_on_demand = unset
# ADR-0004 Phase A1: disable ktlint rules that conflict with Jetpack Compose
# conventions. Composables are PascalCase by Compose convention (function-naming),
# top-level vals in Compose color / theme files often use PascalCase
# (property-naming), and some files contain a primary class plus supporting
# types where the filename does not match the single-class rule (filename).
ktlint_standard_function-naming = disabled
ktlint_standard_property-naming = disabled
ktlint_standard_filename = disabled

[*.{xml,yml,yaml,toml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
