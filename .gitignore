# Personal research notes, journals, and other non-public working files
notes/
logos/

# WSL/Windows alternate-data-stream metadata
*:Zone.Identifier

# Claude Code per-machine state (never commit)
.claude/settings.local.json
.claude/*.lock
/CLAUDE.md

# Design docs kept local: the spec/plan workflow runs locally, not published
/docs/plans/
/docs/specs/

# Play Store listing copy and store screenshots kept local until publish
/docs/play-store-listing.md
/screenshots/play/

# Gradle dependency verification metadata (Phase C2 DEFERRED per ADR-0004;
# see "NOT adopting" section). The bootstrap files generated by
# `./gradlew --write-verification-metadata` stay local-only until the
# operational story (aapt2 capture, Dependabot babysitting cost) is
# resolved upstream or the project's threat model changes.
gradle/verification-metadata.xml
gradle/verification-keyring.gpg
gradle/verification-keyring.keys
gradle/verification-*.deferred-bootstrap

# Android Studio "Gradle JVM criteria" artifact: pins the Gradle daemon JVM
# (locally JBR 21). CI and contributors build on JDK 17, so keep this local to
# avoid forcing a daemon-JVM download in CI. Adopting daemon-JVM-21 project-wide
# would be a deliberate change (bump CI + docs), not an IDE side effect.
gradle/gradle-daemon-jvm.properties

# Private working docs (handoffs, session notes, agent continuity). Never
# committed or published; point contributors at CONTRIBUTING / SECURITY instead.
docs/private/
HANDOFF.md
*.handoff.md
