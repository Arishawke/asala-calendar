# Gradle dependency verification metadata (Phase C2 DEFERRED per ADR-0004;
# see "NOT adopting" section). The bootstrap files generated by
# `./gradlew --write-verification-metadata` stay local-only until the
# operational story (aapt2 capture, Dependabot babysitting cost) is
# resolved upstream or the project's threat model changes.
gradle/verification-metadata.xml
gradle/verification-keyring.gpg
gradle/verification-keyring.keys
gradle/verification-*.deferred-bootstrap
